# ---- SERP source (pick one; the first configured is used unless SERP_PROVIDER is set) ----
# SERP_PROVIDER=serpapi            # serpapi | serper | gateway | browser | google | file | demo
SERPAPI_KEY=                       # https://serpapi.com/manage-api-key  (1 search = 10 results)
SERPER_API_KEY=                    # https://serper.dev/api-key          (cheapest per query)
# Any scraping/render API that returns Google's HTML, parsed locally with Cheerio. {url} = encoded Google URL.
# SCRAPER_API_URL=https://api.scraperapi.com/?api_key=KEY&render=true&url={url}
# SCRAPER_API_URL=https://app.scrapingbee.com/api/v1/?api_key=KEY&render_js=true&url={url}
# SCRAPER_API_URL=http://localhost:8080/fetch?url={url}    # self-hosted gateway
# SCRAPER_API_CONCURRENCY=3
# SERP_TIMEOUT_MS=20000
# browser provider (npm i puppeteer-core uses your installed Chrome/Edge):
# BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# BROWSER_HEADLESS=1
# GOOGLE_MIN_DELAY_MS=9000         # pause between requests for google/browser
# GOOGLE_MAX_DELAY_MS=22000

# ---- AI summary (multi-model fallback; rule-based summary if none answers) ----
GEMINI_API_KEY=                    # https://aistudio.google.com/apikey
GROQ_API_KEY=                      # https://console.groq.com/keys (free, very fast)
NVIDIA_API_KEY=                    # https://build.nvidia.com (free credits)
OPENROUTER_API_KEY=                # https://openrouter.ai/keys (":free" models)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# AI_CHAIN=gemini:gemini-3.6-flash,gemini:gemini-3.5-flash,groq:llama-3.3-70b-versatile
AI_TIMEOUT_MS=10000
AI_TOTAL_BUDGET_MS=30000
AI_HEDGE_MS=6000

# ---- Delivery ----
RESEND_API_KEY=                    # https://resend.com/api-keys (else e-mails go to output/<project>/outbox)
REPORT_EMAIL_FROM=SEO Reports <reports@your-agency.com>
# REPORT_EMAIL_TO=client@example.com,am@your-agency.com   (added to each project's report.email)
# REPORT_EMAIL_REPLY_TO=am@your-agency.com
# Slack, Discord, Teams, telegram://<bot_token>@<chat_id>, or any JSON endpoint (Zapier/Make/n8n), comma separated
WEBHOOK_URLS=
# WEBHOOK_SECRET=                  # HMAC-SHA256 in x-signature-256 for JSON webhooks
# REPORT_BASE_URL=https://reports.your-agency.com   # where output/ is hosted, for links in e-mails/chat
AGENCY_NAME=

# ---- Storage ----
# SERP_DB=data/serp.sqlite
# SERP_PROJECTS_DIR=projects
